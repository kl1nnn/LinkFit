        <mxCell id="n34" value="Regra de dependencia adotada: pages e App conhecem components, hooks, utils e data; components dependem apenas de constants e data. Nenhum modulo de nivel mais baixo importa uma pagina, o que evita ciclos de importacao." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="20" y="1050" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="data/mockData.js funciona como barril (re-exporta os demais arquivos de dados), portanto as paginas importam sempre de um unico ponto." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="530" y="1050" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="data/assets.js monta os caminhos das fotos usando import.meta.env.BASE_URL, o que mantem as imagens funcionando no GitHub Pages (base /LinkFit/)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
