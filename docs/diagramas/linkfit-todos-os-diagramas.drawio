        <mxCell id="n38" value="As conversas sao guardadas por perfil (linkfit-chats-aluno e linkfit-chats-personal) e indexadas pelo indice do contato selecionado. Imagens e audios ficam embutidos como dataURL no proprio JSON." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="640" y="1230" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="O remetente e definido pelo perfil ativo: &#x27;trainer&#x27; quando role = personal e &#x27;me&#x27; quando role = aluno, o que posiciona o balao a direita na tela." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1230" width="450" height="100" as="geometry" />
        </mxCell>
