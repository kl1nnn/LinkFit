        <mxCell id="n36" value="Regra implementada: o sistema so bloqueia o agendamento quando ja existe um treino no mesmo dia e horario, independentemente do aluno, pois a agenda representa a disponibilidade do proprio personal." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1350" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="Como nao ha backend, o novo agendamento vale apenas para o navegador em uso. Ao recarregar a pagina, o hook usePersistedState devolve os agendamentos gravados na chave &#x27;linkfit-bookings&#x27;." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="510" y="1350" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="O mesmo componente AlunoAgenda.jsx atende os dois perfis: no perfil aluno ele apenas filtra os agendamentos do proprio aluno e oculta o botao &#x27;+ Agendar Treino&#x27;." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="980" y="1350" width="440" height="110" as="geometry" />
        </mxCell>
        </root>
      </mxGraphModel>
