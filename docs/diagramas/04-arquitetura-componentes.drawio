        <mxCell id="n59" value="Fluxo de renderizacao: main.jsx monta App.jsx, que decide entre a Landing e o shell autenticado. Dentro do shell, o estado view seleciona a pagina do mapa de views correspondente ao perfil (aluno ou personal)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="1440" y="170" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="Persistencia: usePersistedState encapsula useState + useEffect gravando cada chave no localStorage. Nao existe servidor de aplicacao nem banco de dados; a aplicacao e 100% estatica." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="1440" y="340" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="Midia no chat: imagens sao convertidas em dataURL pelo FileReader e audios sao gravados com MediaRecorder, tambem armazenados em dataURL no localStorage." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="1440" y="510" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="Fotos de perfil: readAvatarFile recorta a imagem no centro usando Canvas 2D e devolve um JPEG 320x320 em dataURL." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF9E6;strokeColor=#D9A441;fontColor=#4A360D;" vertex="1" parent="1">
          <mxGeometry x="1440" y="670" width="350" height="130" as="geometry" />
        </mxCell>
        </root>
